<?xml version="1.0" encoding="utf-8"?>
<!-- Sleek Frosted Glassmorphic Hydro Tracker Square (2x2) AppWidget Layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Progress Circle with Centered Circular Water Logo -->
    <FrameLayout
        android:id="@+id/widget_circle_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal">

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_ring" />

        <ImageView
            android:id="@+id/widget_logo_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_logo"
            android:contentDescription="Hydro Logo" />
    </FrameLayout>

    <!-- Intake Metrics Header Row (Centered) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_text_intake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 2500 ml"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12.5sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_text_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0%"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="10.5sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1.5dp"
            android:paddingBottom="1.5dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Full-Width Capsule Buttons Row (Glass & 250 ml) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_btn_glass"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_btn_bg"
            android:text="Glass"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="none"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_250"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="250 ml"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="none"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
