<?xml version="1.0" encoding="utf-8"?>
<!-- Sleek Frosted Glassmorphic Hydro Tracker Vertical AppWidget Layout (Buttons Below Glass & +250ml) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center">

    <!-- Top Header: Ring + Intake + Percent Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Progress Circle with Centered Water Logo -->
        <FrameLayout
            android:id="@+id/widget_circle_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_ring" />

            <ImageView
                android:id="@+id/widget_logo_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_logo"
                android:contentDescription="Hydro Logo" />
        </FrameLayout>

        <!-- Intake Metric Text -->
        <TextView
            android:id="@+id/widget_text_intake"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="0 / 2500 ml"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Percent Badge -->
        <TextView
            android:id="@+id/widget_text_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Quick Log Section: Row 1 (Glass & +250ml) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_glass"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="Glass"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_250"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="+250 ml"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Quick Log Section: Row 2 (Added BELOW: +500ml, +750ml, +1000ml) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_500"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+500 ml"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_750"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+750 ml"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_1000"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="+1000 ml"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
