<?xml version="1.0" encoding="utf-8"?>
<!-- Sleek Frosted Glassmorphic Hydro Tracker Expanded / Resized AppWidget Layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Upper Section: Large Progress Ring with Centered Water Logo & Intake Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Scaled Progress Circle (72dp x 72dp) -->
        <FrameLayout
            android:id="@+id/widget_circle_container"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_vertical">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_ring" />

            <ImageView
                android:id="@+id/widget_logo_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_logo"
                android:contentDescription="Hydro Logo" />
        </FrameLayout>

        <!-- Metric Details Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_text_intake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 2500 ml"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="19sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Daily Hydration Goal"
                android:textColor="#80FFFFFF"
                android:textSize="11.5sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Percent Badge -->
        <TextView
            android:id="@+id/widget_text_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Lower Section: Large, Thumb-Friendly Action Buttons (48dp Height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_glass"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_btn_bg"
            android:text="Glass"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_250"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="+250 ml"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
