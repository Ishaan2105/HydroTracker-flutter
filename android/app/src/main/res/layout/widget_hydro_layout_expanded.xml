<?xml version="1.0" encoding="utf-8"?>
<!-- Sleek Frosted Glassmorphic Hydro Tracker Expanded / Tier 4 AppWidget Layout (5 Buttons: Glass, +250ml, +500ml, +750ml, +1000ml) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Upper Section: Large Progress Ring with Centered Water Logo & Intake Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Scaled Progress Circle (68dp x 68dp) -->
        <FrameLayout
            android:id="@+id/widget_circle_container"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center_vertical">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_ring" />

            <ImageView
                android:id="@+id/widget_logo_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_logo"
                android:contentDescription="Hydro Logo" />
        </FrameLayout>

        <!-- Metric Details Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_text_intake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 2500 ml"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Daily Hydration Goal"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Percent Badge -->
        <TextView
            android:id="@+id/widget_text_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="12.5sp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/widget_badge_bg"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Lower Section: 5 Thumb-Friendly Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_glass"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="Glass"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_250"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+250 ml"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_500"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+500 ml"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_750"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+750 ml"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_btn_1000"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="+1000 ml"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
