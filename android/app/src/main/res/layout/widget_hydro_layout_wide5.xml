<?xml version="1.0" encoding="utf-8"?>
<!-- Sleek Frosted Glassmorphic Hydro Tracker Wide 1-Row AppWidget Layout (5 Buttons to the side) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Progress Circle with Centered Circular Water Logo -->
    <FrameLayout
        android:id="@+id/widget_circle_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical">

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_ring" />

        <ImageView
            android:id="@+id/widget_logo_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_logo"
            android:contentDescription="Hydro Logo" />
    </FrameLayout>

    <!-- Intake Metrics & 5 Quick Add Buttons Row -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <!-- Intake Header Row (Target Metric + Percent Badge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_text_intake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 / 2500 ml"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_text_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_badge_bg"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Quick Log Options: 5 Buttons to the side of Glass and +250ml -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_glass"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_btn_bg"
                android:text="Glass"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_btn_250"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_btn_bg"
                android:text="+250"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_btn_500"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_btn_bg"
                android:text="+500"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_btn_750"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_btn_bg"
                android:text="+750"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_btn_1000"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:text="+1000"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
