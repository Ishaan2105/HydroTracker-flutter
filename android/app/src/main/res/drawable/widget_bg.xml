<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Glassmorphic Translucent Background for Hydro Tracker Widget -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent deep slate tint (~18% opacity) allows wallpaper to show through with high text contrast -->
    <solid android:color="#2E0F172A" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#4D00E5FF" />
</shape>
